{
  "name": "ochsenbein-red-2023",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@11.1.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild",
      "sharp"
    ]
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/mdx": "^6.0.3",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^6.4.8",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "prettier": "^3.9.7",
    "prettier-plugin-astro": "^0.14.1",
    "sass": "^1.104.1",
    "typescript": "^6.0.3"
  },
  "prettier": {
    "overrides": [
      {
        "files": "*.astro",
        "options": {
          "parser": "astro"
        }
      }
    ],
    "plugins": [
      "prettier-plugin-astro"
    ]
  }
}
